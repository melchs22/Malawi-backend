# Database Configuration
POSTGRES_DB=parkingdb
POSTGRES_USER=parkinguser
POSTGRES_PASSWORD=strongpassword
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/1

# Django Configuration
SECRET_KEY=your-secret-key-here
DEBUG=True
TIME_ZONE=Africa/Blantyre
WORKSHOP_PORTAL_ORIGIN=

# Pesapal Payment Configuration (REQUIRED FOR DEPOSITS)
# Get these from your Pesapal merchant account: https://pay.pesapal.com/
PESAPAL_URL=https://pay.pesapal.com/v3
PESAPAL_CONSUMER_KEY=your-pesapal-consumer-key
PESAPAL_CONSUMER_SECRET=your-pesapal-consumer-secret
PESAPAL_IPN_ID=your-pesapal-ipn-id

# Flutterwave Configuration (REQUIRED FOR AUTOMATED WITHDRAWALS/PAYOUTS)
# Get these from your Flutterwave dashboard: https://dashboard.flutterwave.com/dashboard/settings/apis
FLUTTERWAVE_BASE_URL=https://api.flutterwave.com/v3
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key

# Malawi workshop invoice payments (PayChangu)
# Configure merchant credentials and public HTTPS URLs before enabling checkout.
PAYCHANGU_BASE_URL=https://api.paychangu.com
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=
PAYCHANGU_CALLBACK_URL=
PAYCHANGU_RETURN_URL=
PAYCHANGU_MODE=live
